<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Modules\Agents\Domain\AgentMember" table="agent_members" schema="agents">

        <id name="id" type="uuid" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="agentId" type="agent_id_vo" column="agent_id" nullable="false"/>
        <field name="userId" type="user_id_vo" column="user_id" nullable="false"/>
        <field name="grantedBy" type="user_id_vo" column="granted_by" nullable="false"/>
        <field name="grantedAt" type="datetimetz_immutable" column="granted_at" nullable="false"/>

        <unique-constraints>
            <unique-constraint name="uniq_agents_agent_members_agent_user" columns="agent_id,user_id"/>
        </unique-constraints>

    </entity>

</doctrine-mapping>
