<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Modules\Core\Domain\SystemSetting" table="system_settings" schema="core">

        <id name="name" type="string" column="name" length="100">
            <generator strategy="NONE"/>
        </id>

        <field name="value" type="text" column="value" nullable="true"/>
        <field name="updatedAt" type="datetimetz_immutable" column="updated_at" nullable="false"/>

    </entity>

</doctrine-mapping>
