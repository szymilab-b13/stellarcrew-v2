<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Modules\Workspaces\Domain\Invitation" table="invitations" schema="workspaces">

        <id name="id" type="uuid" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="workspaceId" type="workspace_id_vo" column="workspace_id" nullable="false"/>
        <field name="email" type="string" column="email" length="255" nullable="false"/>
        <field name="role" type="string" column="role" length="20" nullable="false" enum-type="Modules\Workspaces\Domain\WorkspaceRole"/>
        <field name="token" type="string" column="token" length="64" nullable="false"/>
        <field name="expiresAt" type="datetimetz_immutable" column="expires_at" nullable="false"/>
        <field name="invitedBy" type="user_id_vo" column="invited_by" nullable="false"/>
        <field name="acceptedAt" type="datetimetz_immutable" column="accepted_at" nullable="true"/>

        <unique-constraints>
            <unique-constraint name="uniq_workspaces_invitations_token" columns="token"/>
        </unique-constraints>

    </entity>

</doctrine-mapping>
