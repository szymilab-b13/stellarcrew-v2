<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Modules\Workspaces\Domain\WorkspaceMember" table="workspace_members" schema="workspaces">

        <id name="id" type="uuid" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="workspaceId" type="workspace_id_vo" column="workspace_id" nullable="false"/>
        <field name="userId" type="user_id_vo" column="user_id" nullable="false"/>
        <field name="role" type="string" column="role" length="20" nullable="false" enum-type="Modules\Workspaces\Domain\WorkspaceRole"/>
        <field name="invitedBy" type="user_id_vo" column="invited_by" nullable="true"/>
        <field name="joinedAt" type="datetimetz_immutable" column="joined_at" nullable="false"/>

        <unique-constraints>
            <unique-constraint name="uniq_workspaces_members_ws_user" columns="workspace_id,user_id"/>
        </unique-constraints>

    </entity>

</doctrine-mapping>
