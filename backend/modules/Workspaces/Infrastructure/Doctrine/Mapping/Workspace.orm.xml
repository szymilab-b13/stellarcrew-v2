<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Modules\Workspaces\Domain\Workspace" table="workspaces" schema="workspaces">

        <id name="id" type="workspace_id_vo" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="name" type="string" column="name" length="100" nullable="false"/>
        <field name="slug" type="string" column="slug" length="120" nullable="false"/>
        <field name="iconColor" type="string" column="icon_color" length="20" nullable="false"/>
        <field name="iconInitials" type="string" column="icon_initials" length="3" nullable="false"/>
        <field name="ownerId" type="user_id_vo" column="owner_id" nullable="false"/>
        <field name="organizationId" type="organization_id_vo" column="organization_id" nullable="false"/>
        <field name="createdAt" type="datetimetz_immutable" column="created_at" nullable="false"/>
        <field name="updatedAt" type="datetimetz_immutable" column="updated_at" nullable="false"/>
        <field name="deletedAt" type="datetimetz_immutable" column="deleted_at" nullable="true"/>

        <unique-constraints>
            <unique-constraint name="uniq_workspaces_workspaces_slug" columns="slug"/>
        </unique-constraints>

    </entity>

</doctrine-mapping>
