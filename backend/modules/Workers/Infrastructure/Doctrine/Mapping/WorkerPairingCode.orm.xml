<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Modules\Workers\Domain\WorkerPairingCode" table="worker_pairing_codes" schema="workers">

        <id name="code" type="string" column="code" length="9">
            <generator strategy="NONE"/>
        </id>

        <field name="ownerUserId" type="user_id_vo" column="owner_user_id" nullable="false"/>
        <field name="expiresAt" type="datetimetz_immutable" column="expires_at" nullable="false"/>
        <field name="claimedAt" type="datetimetz_immutable" column="claimed_at" nullable="true"/>
        <field name="createdAt" type="datetimetz_immutable" column="created_at" nullable="false"/>

        <indexes>
            <index name="idx_workers_worker_pairing_codes_owner" columns="owner_user_id"/>
        </indexes>

    </entity>

</doctrine-mapping>
