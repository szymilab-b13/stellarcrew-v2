<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Modules\Workers\Domain\WorkerRefreshToken" table="worker_refresh_tokens" schema="workers">

        <id name="tokenHash" type="string" column="token_hash" length="64">
            <options>
                <option name="fixed">true</option>
            </options>
            <generator strategy="NONE"/>
        </id>

        <field name="workerId" type="worker_id_vo" column="worker_id" nullable="false"/>
        <field name="expiresAt" type="datetimetz_immutable" column="expires_at" nullable="false"/>
        <field name="consumedAt" type="datetimetz_immutable" column="consumed_at" nullable="true"/>
        <field name="createdAt" type="datetimetz_immutable" column="created_at" nullable="false"/>

        <indexes>
            <index name="idx_workers_worker_refresh_tokens_worker_id" columns="worker_id"/>
            <index name="idx_workers_worker_refresh_tokens_expires_at" columns="expires_at"/>
        </indexes>

    </entity>

</doctrine-mapping>
