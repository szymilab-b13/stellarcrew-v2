# StellarCrew v2 — backend environment template
# Copy to `backend/.env` and fill in secrets. `backend/.env` is gitignored.
#
# Loading order (last wins):
#   1. backend/.env
#   2. backend/.env.local
#   3. backend/.env.$APP_ENV (committed defaults)
#   4. backend/.env.$APP_ENV.local (gitignored secrets)
#
# Real environment variables always win.

###> symfony/framework-bundle ###
# APP_ENV is sourced from the environment (CLI, docker-compose, phpunit). Dotenv defaults to "dev".
APP_SECRET=ChangeMe
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:app@postgres:5432/stellarcrew?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> stellarcrew/redis ###
REDIS_URL=redis://redis:6379/0
###< stellarcrew/redis ###

###> stellarcrew/rabbitmq ###
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
###< stellarcrew/rabbitmq ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=ChangeMe
###< lexik/jwt-authentication-bundle ###

###> symfony/messenger ###
# Choose transport per use case:
#   MESSENGER_TRANSPORT_DSN=amqp://guest:guest@rabbitmq:5672/%2f/messages
#   MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailpit:1025
###< symfony/mailer ###
