# StellarCrew v2 — environment template
# Copy to `.env` and fill in values. `.env` is gitignored.

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=stellarcrew
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_PORT=5432

# ---- Redis ----------------------------------------------------------------
REDIS_PORT=6379

# ---- Mailpit --------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# ---- Backend (Symfony) — wired up in BL-SETUP-003 ------------------------
# APP_ENV=dev
# APP_SECRET=replace_me
# DATABASE_URL="postgresql://app:app@postgres:5432/stellarcrew?serverVersion=17&charset=utf8"
# REDIS_URL="redis://redis:6379/0"
# MAILER_DSN="smtp://mailpit:1025"

# ---- Frontend (Vite) — wired up in BL-SETUP-004 --------------------------
# VITE_API_URL=http://localhost:8000
